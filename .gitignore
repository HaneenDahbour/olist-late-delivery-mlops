# ==============================
# Data
# ==============================
# Raw Kaggle datasets are stored locally and are not committed.
data/*.csv
data/*.zip

# Keep the data directory in Git
!data/.gitkeep

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*.pyo

.venv/
.venv-service/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ==============================
# MLflow / DVC local state
# ==============================
mlruns/
mlartifacts/
.dvc/cache/
.dvc/tmp/

# ==============================
# Environment variables / secrets
# ==============================
.env
*.env
.env.*

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# IDEs / Editors
# ==============================
.vscode/
.idea/

# ==============================
# Operating system
# ==============================
.DS_Store
Thumbs.db

# ==============================
# Logs
# ==============================
*.log
logs/predictions/*.jsonl
logs/service/*.log

# ==============================
# Local databases / generated files
# ==============================
*.db
*.sqlite
*.sqlite3

# ==============================
# Python build artifacts
# ==============================
build/
dist/
*.egg-info/

# Local database recovery backups
backups/

# Reproducible processed-data artifacts
data/processed/*.parquet

# ==============================
# Task 2 generated notebook artifacts
# ==============================
artifacts/*
!artifacts/.gitkeep
