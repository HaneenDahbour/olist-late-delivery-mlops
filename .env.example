# Copy to .env for local docker-compose use. These are LOCAL DEV
# DEFAULTS ONLY — never reuse them anywhere real. .env itself is
# gitignored; only this .example file is committed.

POSTGRES_DB=olist
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=olist_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Same MinIO credentials, under the names config.yaml's artifact_store
# section reads (ARTIFACT_STORE_ACCESS_KEY/SECRET) and MLflow's S3
# client reads (AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY) — kept in sync
# manually since MinIO doesn't support per-service credential aliases
# in a single-user dev setup.
ARTIFACT_STORE_ACCESS_KEY=minioadmin
ARTIFACT_STORE_SECRET_KEY=minioadmin123
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
